# App
APP_ENV=development

# Required dashboard login (set these before running the app)
DASHBOARD_USERNAME=analyst
DASHBOARD_PASSWORD=change-this-password

# Dev-only bypass - never use in production
# AUTH_DISABLED=true

# Server-to-server API key (required when APP_ENV=production)
# API_KEY=replace-with-a-long-random-secret

# Optional separate JWT signing secret
# JWT_SECRET=replace-with-another-long-random-secret
# JWT_EXPIRE_HOURS=8

# Comma-separated frontend URLs allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Upload and abuse limits
MAX_UPLOAD_BYTES=1048576
MAX_LOG_LINES=1000
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=
